{
  "name": "eos-mcp-server",
  "version": "0.6.0-beta",
  "description": "MCP server for Arista EOS eAPI",
  "type": "module",
  "homepage": "https://github.com/aristanetworks/eos-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristanetworks/eos-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/aristanetworks/eos-mcp-server/issues"
  },
  "keywords": [
    "arista",
    "eos",
    "mcp",
    "model-context-protocol",
    "network-automation"
  ],
  "bin": {
    "eos-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "example-inventories",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "node scripts/static-policy.mjs",
    "prepack": "npm run build",
    "static-policy": "node scripts/static-policy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
